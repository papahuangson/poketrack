# Neon connection string. Use the dev branch locally and main in production.
DATABASE_URL=
# Any long random string. Vercel sends it to /api/cron/nightly.
CRON_SECRET=
# Set by the runner: nas or vercel. Leave empty locally.
RUNNER=
# Set at build time on the NAS image. Leave empty locally.
GIT_SHA=
# The shared passcode for the app. Anyone with it can open the collection, so use a long random one
# (at least 4 random words or 16 random characters). After 10 wrong tries in 15 minutes, sign-in pauses.
APP_PASSCODE=
# Any long random string. Signs the sign-in cookie. Changing it (or the passcode) signs everyone out.
SESSION_SECRET=
# Anthropic API key used to read scan photos.
ANTHROPIC_API_KEY=
# Model for reading scan photos. Defaults to claude-sonnet-5-5 when empty.
ANTHROPIC_MODEL=
# Set automatically when a private Vercel Blob store is connected to the project (scan photos).
# On Vercel the app signs in to the store with the deployment's OIDC token. Locally, run `vercel env pull`
# so BLOB_STORE_ID and VERCEL_OIDC_TOKEN are present.
BLOB_STORE_ID=
