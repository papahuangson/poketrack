# Neon connection string. Use the dev branch locally and main in production.
DATABASE_URL=
# Any long random string. Vercel sends it to /api/cron/nightly.
CRON_SECRET=
# Set by the runner: nas or vercel. Leave empty locally.
RUNNER=
# Set at build time on the NAS image. Leave empty locally.
GIT_SHA=
# The shared passcode for the app. Anyone with it can open the collection.
APP_PASSCODE=
# Any long random string. Signs the sign-in cookie. Changing it (or the passcode) signs everyone out.
SESSION_SECRET=
